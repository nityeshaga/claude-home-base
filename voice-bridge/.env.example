# Required
OPENAI_API_KEY=sk-...

# Where the Slack bot (bot.py from this repo) lives. Its .env supplies SLACK_BOT_TOKEN and its
# .sessions.json is where each call's Claude session is registered so a thread reply resumes it.
# SLACK_BOT_DIR=~/Projects/slack-bot
# SLACK_BOT_TOKEN=xoxb-...            # only if you want to override the bot's .env

# Optional
# VOICE_AGENT_NAME=Jarvis             # the assistant's name on the call and in prompts.md
# VOICE_BRIDGE_PORT=9443
# VOICE_CLAUDE_MODEL=claude-opus-5
# VOICE_CLAUDE_EFFORT=low
# VOICE_LIVE_VOICE=stone              # marin quartz ripple vesper willow stone gleam meridian bossa tempo beacon delta cinder
# VOICE_DEFAULT_USER=U0AAAAAAA        # default caller; otherwise the first entry in callers.json
# VOICE_FAST_FACTS=0                  # 1 = run the search CLI on each delegation and send hits as background
# VOICE_SEARCH_PY=~/claude-home-base/search/venv/bin/python3
# VOICE_SEARCH_SCRIPT=~/claude-home-base/search/luoji_search.py
# CLAUDE_BIN=~/.local/bin/claude

# Telegram front door (telegram/tg_call.py)
# TG_API_ID=
# TG_API_HASH=
# TG_PHONE=+1...                      # only login.py needs this
# TG_SESSION=voice
# VOICE_BRIDGE_WS=wss://127.0.0.1:9443/ws
